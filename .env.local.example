# Resend API key for the Contact form (used in app/api/contact/route.ts).
# Sign in to https://resend.com -> API Keys -> create / copy a key starting with re_
# Then create a file named exactly  .env.local  in this folder and put:
#
#   RESEND_API_KEY=re_your_real_key_here
#
# Restart the dev server after creating .env.local for it to pick up the value.
RESEND_API_KEY=
